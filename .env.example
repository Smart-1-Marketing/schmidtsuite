# Schmidt's Marketing Hot Sheet — environment variables
# Copy into Render. Never commit real values.

# ---- Branding (used in AI copy, emails and the console banner) ----
# These describe THIS client. Nothing about the business is written into the
# prompts, so the same codebase serves any customer by changing these.
BRAND_NAME=Schmidt's Sausage Haus
SITE_URL=schmidthaus.com
# One line: what the business is and what it sells. Every AI prompt uses it.
BRAND_DESCRIPTION=a family-owned German restaurant in Columbus, Ohio's historic German Village, famous for Bahama Mama sausages and cream puffs, with three business lines: the restaurant, catering, and food trucks
BRAND_SHORT=a German restaurant in Columbus
# How generated social photos should look.
BRAND_IMAGE_STYLE=natural window light, shallow depth of field, inviting and real — like a good phone photo from a busy dining room, not a stock advert. Warm wood, hearty plates, a little Bavarian character
# Any rule the AI must always follow for this industry (alcohol, medical, finance...).
BRAND_RULES=

# ---- Ecwid (online store) ----
ECWID_STORE_ID=111281497
ECWID_API_TOKEN=secret_xxxxxxxxxxxxxxxx

# ---- Smart 1 Suite (promotions + leads) ----
GHL_PIT=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=EY0n2rtraCf6EEUKpaEE
PROMO_PIPELINE_NAME=Schmidt Marketing Projects
PROMO_STAGE_NAME=Upcoming Events
# Pipelines behind the two lead KPI tiles
BANQUET_PIPELINE_NAME=Banquet House Request
CATERING_PIPELINE_NAMES=Catering Menu Request,Catering Requests
# Form behind the "+ Submit a New Promotion" button
PROMO_FORM_URL=https://api.leadconnectorhq.com/widget/form/HiSs6ID0Yw8nu5ISjech

# ---- Google Analytics 4 ----
# The GA4 PROPERTY id (Admin -> Property Settings), numeric.
GA4_PROPERTY_ID=
# Option A: OAuth as your own Google account (no GA admin needed). Visit
# /auth/google once deployed to mint the refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Option B: service account key JSON on one line (needs a GA admin).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- OpenAI (social planner, post images, cart recovery drafts) ----
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# Image model for the social planner's "Want an image?" button.
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Ecom Tools (products, discounts, carts, sales tax) ----
# Setting a password ENABLES the Ecom Tools menu. Leave blank and it stays off.
# Product add/edit, photo upload and coupons need the Ecwid token to have
# catalog WRITE access (create_catalog + update_catalog).
ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# ---- Automatic cart recovery via Smart 1 Suite ----
AUTO_RECOVERY=false
AUTO_RECOVERY_COUPON=

# ---- Server ----
ALLOWED_ORIGIN=*
CACHE_SECONDS=300
PORT=10000

# "true" = preview with sample data, no keys needed.
MOCK_MODE=false
